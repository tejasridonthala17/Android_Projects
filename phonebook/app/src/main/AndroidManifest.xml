<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.READ_CONTACTS" />
    <uses-permission android:name="android.permission.WRITE_CONTACTS" />
    <uses-permission android:name="android.permission.READ_SMS" />

    <!-- Custom permissions to guard our own provider -->
    <permission
        android:name="com.example.phonebook.provider.READ_PERMISSION"
        android:protectionLevel="normal" />
    <permission
        android:name="com.example.phonebook.provider.WRITE_PERMISSION"
        android:protectionLevel="normal" />

    <uses-permission android:name="com.example.phonebook.provider.READ_PERMISSION" />
    <uses-permission android:name="com.example.phonebook.provider.WRITE_PERMISSION" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="Phone Book"
        android:theme="@style/AppTheme">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity android:name=".ui.messaging.ComposeActivity" android:exported="false" />
        <activity android:name=".ui.messaging.ConversationActivity" android:exported="false" />

        <!-- Custom Content Provider -->
        <provider
            android:name=".provider.PhoneBookProvider"
            android:authorities="com.example.phonebook.provider"
            android:exported="true"
            android:readPermission="com.example.phonebook.provider.READ_PERMISSION"
            android:writePermission="com.example.phonebook.provider.WRITE_PERMISSION" />

    </application>
</manifest>
