<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp"
    android:gravity="center_horizontal">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Export / Import"
        android:textSize="22sp"
        android:textStyle="bold"
        android:textColor="?attr/colorOnBackground"
        android:layout_marginBottom="32dp"
        android:layout_marginTop="16dp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnExportPhoneContacts"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:layout_marginBottom="16dp"
        android:text="Export Phone Contacts"
        android:textSize="16sp"
        android:textAllCaps="false"
        app:cornerRadius="30dp"
        app:backgroundTint="#7A68C2" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnExportDeviceSms"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:layout_marginBottom="16dp"
        android:text="Export Device SMS"
        android:textSize="16sp"
        android:textAllCaps="false"
        app:cornerRadius="30dp"
        app:backgroundTint="#7A68C2" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnImportPhoneContacts"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:layout_marginBottom="16dp"
        android:text="Import Phone Contacts"
        android:textSize="16sp"
        android:textAllCaps="false"
        app:cornerRadius="30dp"
        app:backgroundTint="#7A68C2" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnImportDeviceSms"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:layout_marginBottom="16dp"
        android:text="Import Device SMS"
        android:textSize="16sp"
        android:textAllCaps="false"
        app:cornerRadius="30dp"
        app:backgroundTint="#7A68C2" />

</LinearLayout>
